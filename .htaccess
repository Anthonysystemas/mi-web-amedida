# =====================================================================
#  .htaccess  ·  mi-web-amedida
#  Versión minimalista: segura en local y en producción.
#  NO fuerza HTTPS (evita bucles de redirección en entorno local).
# =====================================================================

# 1. DESACTIVAR LISTADO DE DIRECTORIOS
#    Evita que se vea el contenido de carpetas sin archivo índice.
Options -Indexes

# 2. PROTECCIÓN BÁSICA
#    Denegar el acceso a dotfiles (.env, .git, .htaccess, etc.).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. COMPRESIÓN DE TEXTO (rendimiento)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# 4. CACHÉ DE ESTÁTICOS (rendimiento)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
</IfModule>

# 5. TIPO MIME PARA WEBP (por si el servidor no lo reconoce)
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>
